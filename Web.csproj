<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace></RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Product>関東ヘリ</Product>
    <Version>0.2.2025.1020</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\新しいフォルダー\**" />
    <Content Remove="wwwroot\新しいフォルダー\**" />
    <EmbeddedResource Remove="wwwroot\新しいフォルダー\**" />
    <None Remove="wwwroot\新しいフォルダー\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB操作 -->
    <PackageReference Include="Dapper" Version="2.1.44" />
    <PackageReference Include="Dapperaid" Version="1.2.1" />
    <!-- メートル単位での距離算出 -->
    <PackageReference Include="GeoCoordinate.NetCore" Version="1.0.0.1" />
    <!-- 最短経路探索ライブラリ -->
    <PackageReference Include="Google.OrTools" Version="9.14.6206" />
    <!-- css/jsの自動minify -->
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
    <!-- cshtmlのエディットコンティニュー(デバッグビルドのみ有効) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.20" Condition="'$(Configuration)'=='Debug'" />
    <!-- GeoJSON操作 -->
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
    <!-- DB操作 -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="Npgsql.NetTopologySuite" Version="9.0.3" />
    <!-- ログ出力 -->
    <PackageReference Include="ZLogger" Version="2.5.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- その他余計なファイル等の除去 -->
    <Content Remove="appsettings.Development.json" Condition="'$(Configuration)'=='Release'" />
  </ItemGroup>
</Project>
