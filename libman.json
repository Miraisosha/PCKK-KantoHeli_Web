{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap-icons@1.13.1",
      "destination": "wwwroot\\lib\\bootstrap-icons",
      "files": [
        "font/bootstrap-icons.css",
        "font/fonts/bootstrap-icons.woff",
        "font/fonts/bootstrap-icons.woff2"
      ]
    },
    {
      "library": "flatpickr@4.6.13",
      "destination": "wwwroot\\lib\\flatpickr",
      "files": [
        "flatpickr.min.js",
        "flatpickr.min.css"
      ]
    },
    {
      "library": "openlayers@10.6.1",
      "destination": "wwwroot\\lib\\openlayers",
      "files": [
        "dist/ol.js",
        "dist/ol.js.map",
        "ol.min.css"
      ]
    },
    {
      "library": "bootstrap-multiselect@1.1.2",
      "destination": "wwwroot\\lib\\bootstrap-multiselect"
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot\\lib\\jquery",
      "files": [
        "jquery.min.js"
      ]
    }
  ]
}