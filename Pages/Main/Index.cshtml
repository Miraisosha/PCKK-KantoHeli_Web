@page "{thread}"
@using Src.Common
@using Src.Services
@using Src.Util
@model IndexModel
@inject LoginService login
@inject ProviderService provider
@{
  ViewData["Title"] = Model.スレッドRec.スレッド名;
  var settings = provider.GetCurrentSettings();
}
@section LibScripts {
  <link rel="stylesheet" href="~/lib/openlayers/ol.min.css" />
  <script defer src="~/lib/openlayers/dist/ol.js"></script>
  <link rel="stylesheet" href="~/lib/bootstrap-multiselect/css/bootstrap-multiselect.min.css" />
  <script defer src="~/lib/jquery/jquery.min.js"></script>@* ←Bootstrap MultiSelectで必要なためやむなく導入 *@
  <script defer src="~/lib/bootstrap-multiselect/js/bootstrap-multiselect.min.js"></script>
}
@section Scripts {
  <link rel="stylesheet" href="~/css/main/index.css" asp-append-version="true" />
  <script defer src="~/js/_map.js" asp-append-version="true"></script>
  <script type="module" src="~/js/main/index.js" asp-append-version="true"></script>
}
@section HeaderLeftArea {
  <div class="navbar-nav">
    <span class="nav-link active">
      <span class="badge rounded-pill text-bg-danger">災害</span>
      @Model.スレッドRec.スレッド名
    </span>
  </div>
}
@section HeaderRightArea {
  <div class="me-4">
    <a asp-page="/Index" type="button" class="btn btn-secondary p-1" onclick="window.close()">閉じる</a>
  </div>
}
<div id="dispArea" data-bottomtab="@Model.BottomTab" style="overflow-y:hidden">
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* 画面左側メニュー部                                                                                  *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  <div id="leftArea">
    <ul class="nav nav-underline ms-2" style="font-size:1.5em">
      <li class="nav-item">
        <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab災害関連情報" role="tab">
          <i class="bi bi-database-fill"></i>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab防災ヘリ関連情報" role="tab">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="28" viewBox="0 0 576 512">
            <path fill="currentColor"
                  d="M176 32c-13.3 0-24 10.7-24 24s10.7 24 24 24l152 0 0 48-220.8 0-32.8-39.4C69.9 83.2 63.1 80 56 80L24 80C15.7 80 8 84.3 3.6 91.4s-4.8 15.9-1.1 23.4l48 96C54.6 218.9 62.9 224 72 224l107.8 0 104 143.1c15.1 20.7 39.1 32.9 64.7 32.9l75.5 0c75.1 0 136-60.9 136-136S499.1 128 424 128l-48 0 0-48 152 0c13.3 0 24-10.7 24-24s-10.7-24-24-24L176 32zM376 192l48 0c39.8 0 72 32.2 72 72s-32.2 72-72 72l-48 0 0-144zM552 416c-13.3 0-24 10.7-24 24 0 4.4-3.6 8-8 8l-272 0c-13.3 0-24 10.7-24 24s10.7 24 24 24l272 0c30.9 0 56-25.1 56-56 0-13.3-10.7-24-24-24z" />
          </svg>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab背景地図選択" role="tab">
          <i class="bi bi-globe2"></i>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tab距離計測" role="tab">
          <i class="bi bi-rulers"></i>
        </button>
      </li>
      <li class="nav-item">
        <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#tabマニュアル類" role="tab">
          <i class="bi bi-info-circle-fill"></i>
        </button>
      </li>
    </ul>
    <div class="tab-content mt-1 p-1">
      @* 災害関連情報 ------------------------------------- *@
      <div id="tab災害関連情報" class="tab-pane" role="tabpanel" tabindex="0">
        <h4>災害関連情報</h4>
        @* リアルタイム情報 *@
        <div data-bs-toggle="collapse" data-bs-target="#leftリアルタイム情報" aria-expanded="true">リアルタイム情報</div>
        <section class="indent collapse show" id="leftリアルタイム情報">
          <div class="striped2" data-bs-toggle="collapse" data-bs-target="#left市区町村震度" aria-expanded="true">市区町村震度</div>
          <section class="collapse show" id="left市区町村震度">
            @foreach (var it in Model.市区町村震度Records)
            {
              <div>
                <label class="form-check">
                  <input class="form-check-input" type="checkbox" name="quake" value="@it.Id" />
                   <span class="form-check-label">@it.Text</span>
                </label>
              </div>
            }
          </section>
          <div class="striped2" data-bs-toggle="collapse" data-bs-target="#leftCCTV映像">CCTV映像（準備中）</div>
        </section>
        @* 事前情報 *@
        <div data-bs-toggle="collapse" data-bs-target="#left事前情報" aria-expanded="true">事前情報</div>
        <section class="indent collapse show" id="left事前情報">
          <div>
            <label class="form-check">
              <input class="form-check-input" type="checkbox" name="jizen" value="heliport"
                     data-geojsonurl="@Url.Content("~/files/heliports.json")">
              <span class="form-check-label">ヘリポート</span>
            </label>
          </div>
          @*
          <div>
            <label class="form-check">
              <input class="form-check-input" type="checkbox" name="jizen" value="xxx"
                     data-geojsonurl="@Url.Content("~/api/mapdata/Heliport")">
              <span class="form-check-label">XXX</span>
            </label>
          </div>
          *@
        </section>
      </div>
      @* 防災ヘリ関連情報 ------------------------------------- *@
      <div id="tab防災ヘリ関連情報" class="tab-pane show active" role="tabpanel" tabindex="0">
        @await Html.PartialAsync("Index_SurveysPartial", this.Model)
      </div>
      @* 背景地図選択 ------------------------------------- *@
      <div id="tab背景地図選択" class="tab-pane" role="tabpanel" tabindex="0">
        <h4>背景地図選択</h4>
        <div>
          <select id="sel背景地図選択" class="form-select w-auto">
            <option value="標準地図">地理院タイル（標準地図）</option>
            <option value="淡色地図">地理院タイル（淡色地図）</option>
            <option value="写真">地理院タイル（写真）</option>
          </select>
        </div>
      </div>
      @* 距離計測 ------------------------------------- *@
      <div id="tab距離計測" class="tab-pane" role="tabpanel" tabindex="0">
        <h4>距離計測</h4>
        <div class="d-flex gap-2 mb-2">
          <button id="btnMeasureStart" class="btn btn-warning">計測開始</button>
          <button id="btnMeasureClear" class="btn btn-secondary">クリア</button>
        </div>

        <div class="fw-bold" style="font-size:20px;border-bottom: 1px solid gray;text-align:right;margin:20px;">
          <span style="width:100px;">合計　</span><span id="measureTotal" style="paddint-left:50px;padding-right:20px;text-align:right;">0 km</span>
        </div>
      </div>
      @* マニュアル ------------------------------------- *@
      <div id="tabマニュアル類" class="tab-pane" role="tabpanel" tabindex="0">
        <h4>マニュアル・問い合わせ先</h4>
        <div class="mt-2">
          <h5><i class="bi bi-square-fill fs-6 me-1"></i>マニュアル</h5>
          <div class="px-2">
            <a href="~/files/manual.pdf" download="操作マニュアル.pdf" class="btn btn-sm btn-link">操作マニュアル.pdf</a>
          </div>
        </div>
        <div class="mt-2">
          <h5><i class="bi bi-square-fill fs-6 me-1"></i>問い合わせ先</h5>
          <div class="px-2">
            関東地方整備局<br>
            統括防災グループ　防災室
          </div>
        </div>
      </div>
    </div>
  </div>
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* 地図表示部                                                                                          *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  <div id="mapArea">
    <div id="map" class="position-absolute top-0 bottom-0 start-0 end-0" data-mapinitx="@settings.MapInitX"
         data-mapinity="@settings.MapInitY" data-mapinitz="@settings.MapInitZ">
      @* 凡例 *@
      <button id="btnLegend"><i class="bi bi-layers" style="margin-right:8px;"></i>凡例</button>
      <div id="mapLegend" class="map-legend">
        <div class="legend-header">
          <span>凡例</span>
          <button class="legend-close">×</button>
        </div>

        <div class="legend-title">調査依頼箇所</div>
        <div class="legend-section">
          @foreach (var org in Model.組織Records.OrderBy(o => o.表示順))
          {
            <div class="legend-row">
              <span class="legend-circle" style="background:@org.ピン表示色"></span>
              <span class="legend-line-org" style="background:@org.ピン表示色"></span>
              <span>@org.組織名</span>
            </div>
          }
        </div>
        <!-- 調査予定ルート -->
        <div class="legend-title">調査予定ルート</div>
        <div class="legend-section">
          <span class="legend-line route"></span>
          <span>移動区間</span>
        </div>
        <!-- 市区町村震度 -->
        <div id="legendCity" style="display:none;">
          <div class="legend-title">市区町村震度</div>
          <div class="legend-row">
            <span class="legend-shindo shindo7"></span>
            <span>震度７</span>
          </div>
          <div class="legend-row">
            <span class="legend-shindo shindo6max"></span>
            <span>震度６強</span>
          </div>
          <div class="legend-row">
            <span class="legend-shindo shindo6min"></span>
            <span>震度６弱</span>
          </div>
          <div class="legend-row">
            <span class="legend-shindo shindo5max"></span>
            <span>震度５強</span>
          </div>
          <div class="legend-row">
            <span class="legend-shindo shindo5min"></span>
            <span>震度５弱</span>
          </div>
          <div class="legend-row">
            <span class="legend-shindo shindo4"></span>
            <span>震度４</span>
          </div>
        </div>
        <!-- ヘリポート -->
        <div class="legend-row" id="legendHeliPort" style="margin-top:10px;display:none;">
          <span ></span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="25">
            <!-- 外円 -->
            <circle cx="50" cy="50" r="32"
                    fill="white"
                    stroke="#000000"
                    stroke-width="6" />
            <g fill="#000000">
              <!-- 左縦 -->
              <rect x="34" y="28" width="10" height="44" />
              <!-- 右縦 -->
              <rect x="56" y="28" width="10" height="44" />
              <!-- 横棒 -->
              <rect x="34" y="47" width="32" height="10" />
            </g>
          </svg>

          <span>ヘリポート</span>
        </div>
      </div>
   </div>
    <div class="position-absolute top-0 end-0 p-4">
      <div class="input-group" style=display:none;">
        <input type="text" class="form-control" style="width:240px" placeholder="住所から検索（準備中）">
        <button type="button" class="btn btn-primary" disabled>検索</button>
      </div>
    </div>
  </div>
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* タブ 画面下段                                                                                       *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  @* *************************************************************************************************** *@
  <div id="bottomArea">
    <div style="z-index:1; position:absolute; margin-top:-32px; padding-left:4px;">
      <button type="button" name="btnタブ選択" value="@IndexModel.TabName調査依頼" class="btn btn-secondary"
              style="width:150px">
        調査依頼
      </button>
      <button type="button" name="btnタブ選択" value="@IndexModel.TabName依頼状況" class="btn btn-secondary"
              style="width:150px">
        調査依頼状況
      </button>
      @if (Model.所属組織Rec?.isルート作成可 == true && Model.特定初動調査区分Rec is not null)
      {
        <button type="button" name="btnタブ選択" value="@IndexModel.TabName特定初動調査" class="btn btn-secondary"
                style="width:150px">
          @Model.特定初動調査区分Rec.初動調査タブ名
        </button>
      }
      @if (Model.所属組織Rec?.isルート作成可 == true)
      {
        <button type="button" name="btnタブ選択" value="@IndexModel.TabNameルート作成" class="btn btn-secondary"
                style="width:150px">
          調査ルート作成
        </button>
      }
      <button type="button" name="btnタブ選択" value="" class="btn btn-dark ms-4">∨</button>
    </div>
    @*-------------------------------------------------------------------
    - 調査依頼タブ
    -------------------------------------------------------------------*@
    <div id="tab調査依頼">
      <div class="row align-items-end m-1 g-1" style="margin-top:-6px !important;">
        <div class="col-auto">
          <label class="cond-label"><i class="bi bi-square-fill ms-1 me-1"></i>登録・削除</label>
          <div class="dropdown">
            <button type="button" class="btn btn-sm btn-info dropdown-toggle" data-bs-toggle="dropdown">地図から追加</button>
            <ul class="dropdown-menu p-2">
              <li><button class="dropdown-item" type="button" name="btn調査地点追加" value="Point">点で登録</button></li>
              <li><button class="dropdown-item" type="button" name="btn調査地点追加" value="LineString">線で登録</button></li>
              <li><button class="dropdown-item" type="button" name="btn調査地点追加" value="River">KPデータ（河川）から登録</button></li>
              <li><button class="dropdown-item" type="button" name="btn調査地点追加" value="Road">KPデータ（道路）から登録</button></li>
            </ul>
          </div>
        </div>
        <div class="col-auto">
          <button type="button" name="btn調査地点削除" class="btn btn-sm btn-info px-4">削除</button>
        </div>
        <div class="col-auto ms-2">
          <label class="cond-label"><i class="bi bi-square-fill ms-1 me-1"></i>オプション</label>
          <div class="dropdown">
            <button type="button" class="btn btn-sm btn-info px-2 dropdown-toggle"
                    data-bs-toggle="dropdown">
              一括操作
            </button>
            <ul class="dropdown-menu">
              <li><button class="dropdown-item" type="button" disabled>優先度一括設定</button></li>
              <li><button class="dropdown-item" type="button" disabled>搭乗希望一括設定</button></li>
              <li><button class="dropdown-item" type="button" disabled>備考一括設定</button></li>
            </ul>
          </div>
        </div>
        <div class="col-auto">
          <button type="button" name="btn調査依頼登録" class="btn btn-sm btn-info px-2"
                  data-modaltitle="調査依頼の一時保存" data-modalcaption="調査依頼名を入力して一時保存してください。" data-modalbutton="一時保存"
                  value="tempsave">
            一時保存
          </button>
        </div>
        <div class="col-auto">
          <button type="button" class="btn btn-sm btn-info" data-bs-toggle="modal"
                  data-bs-target="#modal調査依頼呼び出し" disabled>
            一時保存調査箇所呼び出し
          </button>
        </div>
        <div class="col-auto ms-auto">
          <button type="button" name="btn調査依頼登録" class="btn btn-warning px-2"
                  data-modaltitle="調査依頼" data-modalcaption="調査依頼名を入力して依頼してください。" data-modalbutton="依頼"
                  value="register">
            調査依頼
          </button>
        </div>
      </div>
      <form id="form調査依頼" method="post" asp-page-handler="SurveyRequest" onclick="return false;"
            style="position:absolute; top:4rem; bottom:0; left:0; right:0; overflow-y:scroll;">
        <input type="hidden" name="mode">
        <input type="hidden" name="tempid">
        <table id="table調査依頼" class="table table-sm table-bordered table-striped fixTHead">
          <thead>
            <tr class="table-dark">
              <th style="width:2rem;" class="text-center">
                <input type="checkbox" name="chk全選択" class="form-check-input">
              </th>
              <th style="width:20rem;">地点名</th>
              <th style="width:5rem;">依頼者</th>
              <th style="width:6.5rem;">優先度</th>
              <th style="width:5.5rem;">調査手法</th>
              <th style="width:5rem;">搭乗希望</th>
              <th style="width:5rem;">登録方法</th>
              <th style="">備考</th>
              <th style="width:10rem;">更新日時</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </form>
    </div>
    @*-------------------------------------------------------------------
    - 依頼状況タブ
    -------------------------------------------------------------------*@
    <div id="tab依頼状況">
      <div class="row align-items-end m-1 g-1" style="margin-top:-6px !important;">
        <div class="col-auto">
          <label class="cond-label"><i class="bi bi-square-fill ms-1 me-1"></i>調査依頼選択</label>
          <select name="sel調査依頼" class="form-select form-select-sm" disabled>
            @foreach (var rec in Model.依頼状況調査依頼Records.Where(r => r.ステータス == 調査ステータスEnum.依頼中))
            {
              <option value="@rec.調査依頼id" data-route_id="@rec.初動調査ルートid">@rec.調査依頼名</option>
            }
          </select>
        </div>
        <div class="col-auto ms-2">
          <label class="cond-label"><i class="bi bi-square-fill ms-1 me-1"></i>調査依頼中データの修正</label>
          <label class="form-check pt-1">
            <input class="form-check-input" type="checkbox" value="" id="chk依頼状況_依頼中のみ表示">
            <span class="form-check-label">調査依頼中のデータのみ表示</span>
          </label>
        </div>
        <div class="col-auto ms-3">
          <button type="button" name="btn調査依頼取消" class="btn btn-sm btn-info px-2">依頼取消</button>
        </div>
      </div>
      <form id="form依頼状況" method="post" asp-page-handler="DeleteSpot"
            style="position:absolute; top:4rem; bottom:0; left:0; right:0; overflow-y:scroll;">
        <table id="table依頼状況" class="table table-sm table-bordered table-striped fixTHead">
          <thead>
            <tr class="table-dark">
              <th style="width:2rem;" class="text-center">
                <input type="checkbox" name="chk全選択" class="form-check-input">
              </th>
              <th style="width:20rem;">地点名</th>
              <th style="width:5rem;">依頼者</th>
              <th style="width:6.5rem;">優先度</th>
              <th style="width:5rem;">調査手法</th>
              <th style="width:5rem;">搭乗希望</th>
              <th style="width:5rem;">登録方法</th>
              <th style="">備考</th>
              <th style="width:6rem;">調査状況</th>
              <th style="width:10rem;">更新日時</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </form>
    </div>
    @*-------------------------------------------------------------------
    - 首都直下初動タブ（特定初動調査）
    -------------------------------------------------------------------*@
    @{
      var disabled = !(Model.スレッドRec.初動調査状況 is null or 調査状況Enum.ルート作成中);
    }
    <div id="tab特定初動調査">
      <div class="cond-label"><i class="bi bi-square-fill ms-1 me-1"></i>調査予定ルート選択※（推奨）は震度の大きい箇所を最も優先的に飛行するルート</div>
      <div class="row align-items-center m-1 g-2" style="margin-top:-6px !important;">
        <div class="col-auto">
          <select name="routeid" class="form-select"  disabled="@disabled">
          </select>
        </div>
        <div class="col-auto d-flex align-items-center">
          <label class="me-2 mb-0 text-nowrap">始点</label>
          <input type="text"
                 name="txt始点"
                 class="form-control form-control-sm"
                 style="width:12rem"
                 readonly>
        </div>

        <div class="col-auto d-flex align-items-center">
          <label class="me-2 mb-0 text-nowrap">終点</label>
          <input type="text"
                 name="txt終点"
                 class="form-control form-control-sm"
                 style="width:12rem"
                 readonly>
        </div>


        <div class="col-auto ms-auto">
          <button type="button" name="btn初動調査登録" class="btn btn-warning px-2"
                  data-modaltitle="調査予定ルートとして公開" data-modalcaption="調査ルート名を入力して公開してください。" data-modalbutton="公開"
                  value="register" disabled="@disabled">
            <div class="small lh-1">調査予定ルート<br>として公開</div>
          </button>
        </div>
      </div>
      <div style="position:absolute; top:4rem; bottom:0; left:0px; right:0; overflow-y:scroll;">
        <table id="table特定初動調査" class="table table-sm table-bordered table-striped fixTHead">
          <thead>
            <tr class="table-dark">
              <th style="width:4rem;">巡回順</th>
              <th style="width:25rem;">地点名</th>
              <th style="width:6rem;">依頼者</th>
              <th style="width:5rem;">優先度</th>
              <th style="width:5rem;">調査手法</th>
              <th style="width:5rem;">搭乗希望</th>
              <th style="width:5rem;">登録方法</th>
              <th style="">備考</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </div>
    </div>
